             "ls_up": "Left stick", "ls_down": "Left stick", "ls_left": "Left stick", "ls_right": "Left stick",
             "rs_up": "Right stick", "rs_down": "Right stick"}
# What the map says for controls that are not a LAYOUT action (handled by the Pad itself).
MAP_EXTRA = {
    "base": {"l2": "Hold: the desktop side", "rstick": "Scroll; the further, the faster",
             "chord": "Game mode on / off: the pad goes to the game"},
    "world": {"l2": "Held: the desktop side", "chord": "Game mode on / off: the pad goes to the game"},
}


def map_rows(layer: str) -> list[dict[str, Any]]:
    rows = []
    bound = layout(layer)
    for group, controls in MAP_GROUPS:
        for control in controls:
            if control in bound:
                action = ACTIONS[bound[control]]
                label = action.live_label(action.label) if action.live_label else action.label
                if not label:
                    continue  # not set up in the config: it does nothing
                labels = {**(action.labels or {}), **getattr(action.run, "kind_labels", {})}
                kinds = list(getattr(action.run, "kinds", ["*"]))
            elif control in MAP_EXTRA[layer]:
                label, labels, kinds = MAP_EXTRA[layer][control], {}, ["*"]
            else:
                continue
            name = MAP_NAMES.get(control) or CONTROL_NAMES[control]
            rows.append({"control": control, "group": group, "glyph": GLYPHS.get(control, ""), "name": name,
                         "label": label, "labels": labels, "kinds": kinds})
    return rows


def pad_battery() -> str:
    """The pad's charge for the map, "" when no DualSense is there."""
    found = sorted(glob.glob(BATTERY.format(mac="*")))
    for base in found:
        try:
            return Path(base, "capacity").read_text().strip() + "%"
        except OSError:
            continue
    return ""


def print_map(as_json: bool) -> None:
    layers = {layer: map_rows(layer) for layer in LAYOUT}
    if as_json:
        print(json.dumps({"layers": layers, "layer_names": LAYER_NAMES, "battery": pad_battery()}, indent=1))
        return
    for layer, rows in layers.items():
        if not rows:
            continue
        print(LAYER_NAMES[layer])
        for row in rows:
            print(f"  {row['glyph'] or ' '} {row['name']:<12} {row['label']}")


def check(hypr: Hypr) -> int:
    """Builds every action's dispatcher in the running Hyprland without running one. 0 = all build."""
    failed = 0
    extra = {"scroll_pointer": POINTER_TO.format(x=0, y=0)}  # dispatchers that are not a control's
    if CONFIG.wheel.plugin:
        extra["sessions_wheel"] = f'hl.dsp.event("{CONFIG.wheel.plugin} cancel")'
    extra["map"] = f'hl.dsp.event("{MAP_ID} hide")'
    for name, expr in extra.items():
        answer = hypr.request(f"eval local _ = {expr}")
        ok = answer is not None and answer.strip() == "ok"
        failed += not ok
        print(f"{'ok  ' if ok else 'FAIL'} {name}{'' if ok else ': ' + (answer or 'Hyprland does not answer').strip()}")
    for name, action in ACTIONS.items():
        problems = []
        for probe in getattr(action.run, "probes", []):
            answer = hypr.request(f"eval {probe}")
            if answer is None or answer.strip() != "ok":
                problems.append((answer or "Hyprland does not answer").strip())
        # A key name is resolved only when a chord is sent, and a bad one then raises Hyprland's
        # red error bar on the screen; so the names are checked here, in libxkbcommon itself.
        problems += [f"{sym} is not a key name" for sym in getattr(action.run, "keysyms", []) if not keysym_known(sym)]
        if not hasattr(action.run, "probes"):
            continue  # not Hyprland's (talk, ideas, map)
        failed += bool(problems)
        print(f"{'FAIL' if problems else 'ok  '} {name}{': ' + '; '.join(problems) if problems else ''}")
    return 1 if failed else 0


def keysym_known(name: str) -> bool:
    """xkb_keysym_from_name, as Hyprland's resolveKeycode calls it (case-insensitive)."""
    import ctypes
    import ctypes.util

    lib = ctypes.CDLL(ctypes.util.find_library("xkbcommon") or "libxkbcommon.so.0")
    lib.xkb_keysym_from_name.argtypes = [ctypes.c_char_p, ctypes.c_int]
    lib.xkb_keysym_from_name.restype = ctypes.c_uint32
    return lib.xkb_keysym_from_name(name.encode(), 1) != 0


def print_status() -> None:
    try:
        dev = find_pad()
    except ImportError:
        print("pad: python-evdev is not installed")
        dev = None
    else:
        if dev is None:
            print("pad: not connected")
        else:
            where = input_dir(dev)
            print(f"pad: {dev.name} at {dev.path}, battery {battery(where)}")
            rgb = SysfsLights(where).rgb / "multi_intensity"
            if not rgb.exists():
                print("lights: none on this pad")
            else:
                print(f"lights: {'writable' if os.access(rgb, os.W_OK) else 'not writable (install the udev rule)'}")
            if not has_mic(dev.info.vendor, dev.info.product):
                print("mic button: none on this pad")
            else:
                nodes = sorted(Path(where, "device").glob("hidraw/hidraw*"))
                node = f"/dev/{nodes[0].name}" if nodes else "none"
                readable = bool(nodes) and os.access(node, os.R_OK)
                print(f"mic button: {node} {'readable' if readable else 'not readable (install the udev rule)'}")
            dev.close()
    hypr = Hypr()
    active = hypr.json("activewindow")
    if active is None:
        print("hyprland: not answering")
    else:
        print(f"hyprland: {hypr.signature[:24]}..., focused: {active.get('class') or '-'}")


def main(argv: list[str] | None = None) -> int:
    global CONFIG
    parser = argparse.ArgumentParser(prog="hypr-gamepad", description="A gamepad drives Hyprland.")
    sub = parser.add_subparsers(dest="cmd", required=True)
    run = sub.add_parser("run", help="the daemon")
    run.add_argument("--dry", action="store_true", help="print actions instead of sending them")
    run.add_argument("--device", help="this event node instead of the first DualSense found")
    status = sub.add_parser("status", help="the pad, its battery, Hyprland, the config")
    check_it = sub.add_parser("check", help="read the config, and build every action in the running Hyprland "
                                            "without running it")
    show = sub.add_parser("map", help="what each control does")
    show.add_argument("--json", action="store_true")
    for command in (run, status, check_it, show):
        command.add_argument("--config", metavar="PATH",
                             help=f"the config file (default {default_config_path()}; none there: the defaults)")
    args = parser.parse_args(argv)
    logging.basicConfig(level=logging.INFO if args.cmd == "run" else logging.WARNING,
                        format="hypr-gamepad: %(message)s")

    source = Path(args.config) if args.config else default_config_path()
    try:
        CONFIG, warnings = read_config(args.config)
    except ConfigError as exc:
        if args.cmd == "check":
            print(f"FAIL config: {exc}")
            return 1
        log.error("%s", exc)
        return 2
    if args.cmd == "check":  # check says it all on stdout, the config first
        for warning in warnings:
            print(f"warn config: {warning}")
        print(f"ok   config: {source}{'' if source.exists() else ' (none: the defaults)'}")
    else:
        for warning in warnings:
            log.warning("%s", warning)

    if args.cmd == "map":
        print_map(args.json)
    elif args.cmd == "status":
        print_status()
        print(f"config: {source}{'' if source.exists() else ' (none: the defaults)'}")
    elif args.cmd == "check":
        return check(Hypr())
    else:
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
        run_daemon(args.dry, args.device)
    return 0


if __name__ == "__main__":
    sys.exit(main())
