# --- Talking -------------------------------------------------------------------------------------

class Proc(Protocol):
    def poll(self) -> int | None: ...


class Runner:
    """Starts programs in their own session, so a restart of hypr-gamepad never cuts a paste short, and
    reaps them."""

    def __init__(self) -> None:
        self.children: list[subprocess.Popen[bytes]] = []

    def spawn(self, argv: list[str]) -> Proc | None:
        try:
            child = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError as exc:
            log.info("%s: %s", argv[0], exc)
            return None
        self.children.append(child)
        return child

    def capture(self, argv: list[str], out: Path) -> Proc | None:
        """Starts a program whose answer is read later from `out` (a file, so a long answer never
        fills a pipe that nobody reads until the program ends)."""
        try:
            with out.open("wb") as sink:
                child = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=sink, stderr=subprocess.DEVNULL,
                                         start_new_session=True)
        except OSError as exc:
            log.info("%s: %s", argv[0], exc)
            return None
        self.children.append(child)
        return child

    def reap(self) -> None:
        self.children = [c for c in self.children if c.poll() is None]


class DryRunner(Runner):
    """--dry: says what it would start, starts nothing."""

    class Done:
        def poll(self) -> int | None:
            return 0

    def spawn(self, argv: list[str]) -> Proc | None:
        print(f"dry: run {' '.join(argv)}", flush=True)
        return self.Done()

    def capture(self, argv: list[str], out: Path) -> Proc | None:
        """Reading is harmless: --dry reads the wheel's list for real, so the dry jump names its agent."""
        return Runner.capture(self, argv, out)


def voice_dir() -> Path:
    return Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "ormus-voice")


TAP_S = 0.35  # a control let go sooner than this was tapped
TALK_LATCH_S = TAP_S
START_WAIT_S = 3.0  # how long a pad that went away waits for a starting recorder before dropping it  # R2 let go sooner than this was a tap: the recording goes on until the next tap


class Talk:
    """R2: hold to talk, let go to paste; a tap keeps listening until the next tap. [talk] backend
    "voice-flow"; `toggle` is the command, `state_dir` where it keeps its state.

    voice-flow does the work, as Super+H: its first call starts recording (recording.state appears),
    its second transcribes and pastes into the focused window, or leaves the words on the clipboard
    when focus moved meanwhile. States: idle -> starting -> recording -> stopping -> idle.

    recording.state is the truth: a recording that ended without Talk (Super+H, voice-flow's own cap)
    sends Talk back to idle, and a pad that goes away waits for a starting recorder and drops it, so
    nothing the user did not let go of is ever pasted (independent review, 2026-10-29)."""

    def __init__(self, runner: Runner, fx: Fx, clock: Callable[[], float], state_dir: Path,
                 toggle: tuple[str, ...]):
        self.runner, self.fx, self.clock, self.dir = runner, fx, clock, state_dir
        self.toggle = list(toggle)
        self.sleep: Callable[[float], None] = time.sleep  # reset() waits on a starting recorder
        self.state = "idle"
        self.proc: Proc | None = None
        self.held = False
        self.pressed_at = 0.0
        self.stop_wanted = self.drop_wanted = False

    def recording_file(self) -> Path:
        return self.dir / "recording.state"

    def active(self) -> bool:
        return self.state in ("starting", "recording")

    def call_voice_flow(self, next_state: str) -> None:
        self.proc = self.runner.spawn(list(self.toggle))
        if self.proc is None:
            self.fx.notify("Talk", f"{self.toggle[0]} did not start")
            self.state, self.held = "idle", False
            return
        self.state = next_state

    def ended_elsewhere(self) -> bool:
        """Talk records, but voice-flow's file is gone: something else ended the recording."""
        if self.state == "recording" and not self.recording_file().exists():
            log.info("talk: the recording ended without the pad")
            self.state, self.held = "idle", False
            return True
        return False

    def press(self) -> None:
        self.ended_elsewhere()
        if self.state == "idle":
            if self.recording_file().exists():  # a recording from Super+H: R2 ends it
                self.call_voice_flow("stopping")
                return
            self.held, self.pressed_at = True, self.clock()
            self.stop_wanted = self.drop_wanted = False
            self.fx.rumble("tick")
            self.call_voice_flow("starting")
        elif self.state == "recording":           # latched: this tap ends it
            self.call_voice_flow("stopping")
        elif self.state == "starting":
            self.stop_wanted = True
        else:
            self.fx.notify("Talk", "Still pasting the last words")

    def release(self) -> None:
        if not self.held:
            return
        self.held = False
        if self.clock() - self.pressed_at < TALK_LATCH_S:
            self.fx.rumble("click")               # a tap: it keeps listening
            return
        if self.state == "starting":
            self.stop_wanted = True
        elif self.state == "recording":
            self.call_voice_flow("stopping")

    def drop(self) -> bool:
        """Circle while talking: the recording goes, nothing is pasted. True when it dropped one."""
        self.ended_elsewhere()
        if not self.active():
            return False
        self.held = False
        if self.state == "starting":
            self.drop_wanted = True
        else:
            self.discard()
        return True

    def discard(self) -> None:
        """Stop the recorder voice-flow started (recording.state holds its pid and file), delete its file,
        tell the pill."""
        state = self.recording_file()
        try:
            pid, _, wav = state.read_text(encoding="utf-8", errors="replace").partition(":")
        except OSError:
            pid, wav = "", ""
        state.unlink(missing_ok=True)
        if pid.strip().isdigit():
            try:
                os.kill(int(pid.strip()), signal.SIGTERM)
            except OSError:
                pass
        if wav.strip():
            Path(wav.strip()).unlink(missing_ok=True)
        (self.dir / "agent.mode").unlink(missing_ok=True)
        try:
            (self.dir / "pill.state").write_text("cancel", encoding="utf-8")
        except OSError:
            pass
        self.state, self.proc = "idle", None
        self.fx.rumble("click")

    def tick(self) -> None:
        self.ended_elsewhere()
        if self.proc is None or self.proc.poll() is None:
            return
        self.proc = None
        if self.state == "starting":
            if self.drop_wanted:
                self.discard()
            elif not self.recording_file().exists():
                self.state = "idle"
                self.fx.notify("Talk", "The recording did not start")
            else:
                self.state = "recording"
                if self.stop_wanted:
                    self.call_voice_flow("stopping")
        elif self.state == "stopping":
            self.state = "idle"
            pill = ""
            try:
                pill = (self.dir / "pill.state").read_text(encoding="utf-8", errors="replace")
            except OSError:
                pass
            # done: pasted; copied: on the clipboard because focus moved; cancel:<why>: nothing heard
            self.fx.rumble("double" if pill.startswith(("done", "copied")) else "tick")

    def reset(self) -> None:
        """The pad went away mid-sentence, or the daemon stops: never paste what nobody let go of.

        The daemon drops this Pad afterwards and never ticks it again, so a recorder still starting
        is waited for here (voice-flow's start takes about 0.3 s) and then dropped."""
        self.ended_elsewhere()
        if not self.active():
            self.held = False
            return
        if self.state == "starting" and self.proc is not None:
            waited = 0.0
            while self.proc.poll() is None and waited < START_WAIT_S:
                self.sleep(0.05)
                waited += 0.05
            if self.proc.poll() is None:
                log.info("talk: voice-flow's start did not end in %.0f s; dropping what is there", START_WAIT_S)
        self.discard()  # recording.state, if voice-flow's start wrote it: its recorder is stopped
        self.fx.notify("Talk", "The pad went away: the recording was dropped")
        self.held = False


class CommandTalk:
    """[talk] backend "command": a dictation tool driven by plain commands, with Talk's feel. A press
    runs `start`; let go after a hold runs `stop` (the tool types the words); a tap keeps listening
    until the next press, which runs `stop`; Circle runs `cancel`. The commands are only started:
    whether anything was heard is the tool's to say."""

    def __init__(self, runner: Runner, fx: Fx, clock: Callable[[], float], talk: TalkConfig):
        self.runner, self.fx, self.clock, self.config = runner, fx, clock, talk
        self.state = "idle"  # idle | talking
        self.held = False
        self.pressed_at = 0.0

    def active(self) -> bool:
        return self.state == "talking"

    def call(self, argv: tuple[str, ...]) -> bool:
        if argv and self.runner.spawn(list(argv)) is None:
            self.fx.notify("Talk", f"{argv[0]} did not start")
            return False
        return True

    def press(self) -> None:
        if self.active():                      # latched: this press ends it
            self.end(self.config.stop, "double")
        elif self.call(self.config.start):
            self.state, self.held, self.pressed_at = "talking", True, self.clock()
            self.fx.rumble("tick")

    def release(self) -> None:
        if not self.held:
            return
        self.held = False
        if self.clock() - self.pressed_at < TALK_LATCH_S:
            self.fx.rumble("click")            # a tap: it keeps listening
        else:
            self.end(self.config.stop, "double")

    def end(self, argv: tuple[str, ...], rumble: str) -> None:
        self.state, self.held = "idle", False
        self.call(argv)
        self.fx.rumble(rumble)

    def drop(self) -> bool:
        """Circle while talking: `cancel`, nothing is typed. True when it dropped one."""
        if not self.active():
            return False
        self.end(self.config.cancel, "click")
        return True

    def tick(self) -> None:
        pass

    def reset(self) -> None:
        """The pad went away: never type what nobody let go of."""
        if self.drop():
            self.fx.notify("Talk", "The pad went away: the recording was dropped")


class NoTalk:
    """[talk] backend "none": the first press says where talk is set up."""

    state = "idle"

    def __init__(self, fx: Fx):
        self.fx, self.said = fx, False

    def press(self) -> None:
        if not self.said:
            self.said = True
            self.fx.notify("Talk is not set up", "see [talk] in the config")

    def release(self) -> None:
        pass

    def drop(self) -> bool:
        return False

    def active(self) -> bool:
        return False

    def tick(self) -> None:
        pass

    def reset(self) -> None:
        pass


def make_talk(runner: Runner, fx: Fx, clock: Callable[[], float],
              state_dir: Path | None = None) -> Talk | CommandTalk | NoTalk:
    """The talk backend [talk] names. `state_dir` stands in for voice-flow's own (the tests')."""
    talk = CONFIG.talk
    if talk.backend == "command":
        return CommandTalk(runner, fx, clock, talk)
    if talk.backend == "none":
        return NoTalk(fx)
    if state_dir is None:
        state_dir = Path(os.path.expanduser(talk.state_dir)) if talk.state_dir else voice_dir()
    return Talk(runner, fx, clock, state_dir, talk.toggle)


# --- Scrolling -----------------------------------------------------------------------------------

SCROLL_DEAD = 0.18               # tilt below this is the stick at rest
SCROLL_MAX = (2400.0, 1200.0)    # hi-res wheel units a second at full tilt: up/down, left/right (120 = a notch)


def scroll_rate(tilt: float, top: float) -> float:
    """Hi-res units a second for a tilt in -1..1: nothing in the dead zone, then a square curve, so a
    small tilt reads line by line and a full one flies."""
    if abs(tilt) <= SCROLL_DEAD:
        return 0.0
    share = (abs(tilt) - SCROLL_DEAD) / (1.0 - SCROLL_DEAD)
    return (1.0 if tilt > 0 else -1.0) * share * share * top


POINTER_TO = "hl.dsp.cursor.move({{ x = {x}, y = {y} }})"


class Wheel:
    """Where scroll goes: a virtual mouse wheel (the shell's is a uinput device; this one does nothing)."""

    def scroll(self, vertical: int, horizontal: int, notches_v: int, notches_h: int) -> None:
        pass


class Scroll:
    """The right stick as a smooth wheel. A wheel scrolls what is under the pointer, so when a scroll
    starts with the pointer outside the focused window, the pointer first moves to that window's
    middle: the scroll goes where the user looks, and focus stays (the pointer lands in the focused window)."""

    def __init__(self, hypr: Hypr, wheel: Wheel, clock: Callable[[], float]):
        self.hypr, self.wheel, self.clock = hypr, wheel, clock
        self.x = self.y = 0.0
        self.moving = False
        self.last = clock()
        self.paused = False       # after the wheel: no scroll until the stick has rested once
        self.carry = [0.0, 0.0]   # hi-res units not sent yet: vertical, horizontal
        self.notch = [0.0, 0.0]   # hi-res units toward the next low-res notch

    def stick(self, x: float, y: float) -> None:
        if self.paused and abs(x) <= SCROLL_DEAD and abs(y) <= SCROLL_DEAD:
            self.paused = False
        self.x, self.y = (0.0, 0.0) if self.paused else (x, y)

    def pause(self) -> None:
        self.paused = True
        self.x = self.y = 0.0

    def tick(self) -> None:
        now = self.clock()
        elapsed, self.last = min(now - self.last, 0.1), now
        rate_v, rate_h = scroll_rate(-self.y, SCROLL_MAX[0]), scroll_rate(self.x, SCROLL_MAX[1])
        if not rate_v and not rate_h:
            if self.moving:
                self.moving = False
                self.carry = [0.0, 0.0]
                self.wheel.scroll(0, 0, 0, 0)  # the end of a gesture (the dry wheel says its total)
            return
        if not self.moving:
            self.moving = True
            self.aim_pointer()
        out = []
        for axis, rate in enumerate((rate_v, rate_h)):
            self.carry[axis] += rate * elapsed
            units = int(self.carry[axis])
            self.carry[axis] -= units
            self.notch[axis] += units
            notches = int(self.notch[axis] / 120)
            self.notch[axis] -= notches * 120
            out += [units, notches]
        if any(out):
            self.wheel.scroll(out[0], out[2], out[1], out[3])

    def aim_pointer(self) -> None:
        win, pos = self.hypr.json("activewindow"), self.hypr.json("cursorpos")
        try:
            (wx, wy), (ww, wh) = win["at"], win["size"]
            px, py = pos["x"], pos["y"]
        except (KeyError, TypeError, ValueError):
            return
        if wx <= px < wx + ww and wy <= py < wy + wh:
            return
        self.hypr.dispatch(POINTER_TO.format(x=wx + ww // 2, y=wy + wh // 2))

    def reset(self) -> None:
        self.x = self.y = 0.0
        self.moving = False
        self.carry = [0.0, 0.0]


# --- The sessions wheel ---------------------------------------------------------------------------

AIM_EVERY_S = 0.03   # the stick's aim reaches the wheel at most this often
AIM_STEP = 0.05      # and only when it moved this much


def focused_center(hypr: Hypr) -> tuple[float, float] | None:
    """The middle of the focused screen, in Hyprland's layout coordinates (logical pixels)."""
    for mon in hypr.json("monitors") or []:
        if not isinstance(mon, dict) or not mon.get("focused"):
            continue
        try:
            scale = float(mon.get("scale") or 1.0)
            width, height = float(mon["width"]) / scale, float(mon["height"]) / scale
            if int(mon.get("transform") or 0) % 2:  # turned a quarter: width and height swap
                width, height = height, width
            return float(mon["x"]) + width / 2, float(mon["y"]) + height / 2
        except (KeyError, TypeError, ValueError):
            return None
    return None


class SessionsWheel:
    """PS held: a sessions wheel (the Omarchy shell plugin [wheel].plugin names) opens in the middle of
    the focused screen; the right stick lights the slot it points at; letting go of PS shows that
    session (the wheel does the jump, as for the mouse); Circle closes it, no jump. No plugin: off.

    It talks to the plugin with Hyprland events: "padhold <token> <x> <y>", "aim <token> <sx> <sy>",
    "release <token> nan nan", "cancel"."""

    def __init__(self, hypr: Hypr, fx: Fx, clock: Callable[[], float]):
        self.hypr, self.fx, self.clock = hypr, fx, clock
        self.token: str | None = None
        self.seq = 0
        self.sent = self.want = (0.0, 0.0)
        self.last = float("-inf")

    def send(self, message: str) -> None:
        self.hypr.dispatch(f'hl.dsp.event("{CONFIG.wheel.plugin} {message}")')

    def open(self) -> None:
        if not CONFIG.wheel.plugin:
            return  # no wheel: a long PS press does nothing
        center = focused_center(self.hypr)
        x, y = center if center else (float("nan"), float("nan"))
        self.seq += 1
        self.token = f"pad{int(time.time())}-{self.seq}"
        self.sent = self.want = (0.0, 0.0)
        self.send(f"padhold {self.token} {x:.1f} {y:.1f}")
        self.fx.rumble("click")

    def aim(self, x: float, y: float) -> None:
        if self.token is None:
            return
        self.want = (round(x / AIM_STEP) * AIM_STEP, round(y / AIM_STEP) * AIM_STEP)
        self.flush()

    def flush(self, now: bool = False) -> None:
        if self.token is None or self.want == self.sent:
            return
        if not now and self.clock() - self.last < AIM_EVERY_S:
            return
        self.last, self.sent = self.clock(), self.want
        self.send(f"aim {self.token} {self.want[0]:.2f} {self.want[1]:.2f}")

    def release(self) -> None:
        if self.token is None:
            return
        self.flush(now=True)
        self.send(f"release {self.token} nan nan")
        self.token = None

    def cancel(self) -> bool:
        if self.token is None:
            return False
        self.send("cancel")
        self.token = None
        self.fx.rumble("click")
        return True


# --- Jumping to the agent that waits --------------------------------------------------------------

JUMP_CYCLE_S = 10.0  # Triangle again within this walks on down the same list; later, a fresh list


class Jump:
    """Triangle, [jump] backend "command": show the agent that waits on the user most; press again for
    the next one.

    `items` prints the list, the one that needs the user first at the top ({"items": [{"key", "name",
    "host", "workspace", "why", "lane"}, ...]}); `go` shows one, its key where "{key}" stands or at the
    end. A list from the same tool as a board or a wheel keeps the three from disagreeing."""

    def __init__(self, runner: Runner, fx: Fx, clock: Callable[[], float]):
        self.runner, self.fx, self.clock = runner, fx, clock
        self.items: list[dict[str, Any]] = []
        self.index = -1
        self.last = float("-inf")
        self.listing: tuple[Proc, Path] | None = None
        self.jumping: Proc | None = None

    def press(self) -> None:
        if self.listing is not None:
            return  # the list is on its way
        now = self.clock()
        if self.items and now - self.last < JUMP_CYCLE_S:
            self.last = now
            self.index = (self.index + 1) % len(self.items)
            self.go()
            return
        self.last = now
        handle, name = tempfile.mkstemp(prefix="hypr-gamepad-wheel-", suffix=".json")
        os.close(handle)
        out = Path(name)
        argv = list(CONFIG.jump.items)
        proc = self.runner.capture(argv, out)
        if proc is None:
            out.unlink(missing_ok=True)
            self.fx.notify("Agents", f"{argv[0]} did not start")
            return
        self.listing = (proc, out)

    def tick(self) -> None:
        if self.listing is not None and self.listing[0].poll() is not None:
            proc, out = self.listing
            self.listing = None
            try:
                items = json.loads(out.read_text(encoding="utf-8")).get("items") if proc.poll() == 0 else None
            except (OSError, ValueError, AttributeError):
                items = None
            out.unlink(missing_ok=True)
            if not isinstance(items, list):
                self.items = []
                self.fx.notify("Agents", f"{Path(CONFIG.jump.items[0]).name} does not answer")
            elif not items:
                self.items = []
                self.fx.rumble("click")
                self.fx.notify("Agents", "Nothing waits on you")
            else:
                self.items, self.index = items, 0
                self.go()
        if self.jumping is not None and self.jumping.poll() is not None:
            if self.jumping.poll() == 0:
                self.fx.rumble("double")
            self.jumping = None  # a failed jump: the command says why, or nothing does

    def go(self) -> None:
        item = self.items[self.index]
        where = " · ".join(str(x) for x in (item.get("host"), item.get("workspace")) if x)
        why = item.get("why") or {"blocked": "waits on you", "done": "done, not seen yet"}.get(str(item.get("lane")), "")
        self.fx.notify(f"{self.index + 1} of {len(self.items)}: {item.get('name') or item.get('key')}",
                       " · ".join(x for x in (where, why) if x))
        self.fx.rumble("tick")
        key, go = str(item.get("key")), list(CONFIG.jump.go)
        argv = [key if arg == "{key}" else arg for arg in go] + ([] if "{key}" in go else [key])
        self.jumping = self.runner.spawn(argv)

    def reset(self) -> None:
        if self.listing is not None:
            self.listing[1].unlink(missing_ok=True)
        self.listing = None


# --- The map on screen ----------------------------------------------------------------------------

MAP_ID = "ormus.hypr-gamepad-map"


class PadMap:
    """Options: the shell plugin ormus.hypr-gamepad-map shows what each control does, for the focused
    window's kind and the layer in force; it reads the rows from `hypr-gamepad map --json`, this file's own
    table. Held: up while held. Tapped: up until the next Options. L2 while it is up shows the desktop
    side. Hyprland events: "show <kind> <layer> <grouped 0|1>", "hide"."""

    def __init__(self, hypr: Hypr, clock: Callable[[], float]):
        self.hypr, self.clock = hypr, clock
        self.up = False
        self.latched = False
        self.kind = "other"
        self.grouped = False
        self.pressed_at = 0.0

    def send(self, message: str) -> None:
        self.hypr.dispatch(f'hl.dsp.event("{MAP_ID} {message}")')

    def press(self, kind: str, layer: str, grouped: bool = False) -> None:
        if self.up and self.latched:
            self.hide()
            self.pressed_at = float("-inf")  # this press only closed it
            return
        self.kind, self.grouped = kind, grouped
        self.pressed_at, self.up, self.latched = self.clock(), True, False
        self.send(f"show {kind} {layer} {int(grouped)}")

    def release(self) -> None:
        if not self.up:
            return
        if self.clock() - self.pressed_at < TAP_S:
            self.latched = True
        else:
            self.hide()

    def layer(self, layer: str) -> None:
        if self.up:
            self.send(f"show {self.kind} {layer} {int(self.grouped)}")

    def hide(self) -> None:
        if self.up:
            self.send("hide")
        self.up = self.latched = False


