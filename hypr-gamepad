CONFIG = Config()  # main() sets it from the file before anything runs
TALK_BACKENDS = ("voice-flow", "command", "none")
JUMP_BACKENDS = ("herdr", "command", "none")
PLUGIN_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*")  # it goes into a Lua string: nothing to escape


class ConfigError(Exception):
    """A config the pad cannot run with; the message names the key."""


def default_config_path() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return Path(base, "hypr-gamepad", "config.toml")


def read_config(path: str | Path | None) -> tuple[Config, list[str]]:
    """The config at `path`, and a warning for each key it does not know. No path: the default one,
    where no file means the defaults; a path that was named must be there."""
    named = path is not None
    path = Path(path) if path is not None else default_config_path()
    try:
        with path.open("rb") as handle:
            table = tomllib.load(handle)
    except FileNotFoundError:
        if named:
            raise ConfigError(f"{path}: no such file") from None
        return Config(), []
    except (OSError, tomllib.TOMLDecodeError) as exc:
        raise ConfigError(f"{path}: {exc}") from None
    warnings: list[str] = []
    try:
        config = build(Config, table, "", warnings)
        validate(config)
    except ConfigError as exc:
        raise ConfigError(f"{path}: {exc}") from None
    return config, [f"{path}: {warning}" for warning in warnings]


def load_config(path: str | Path | None = None) -> Config:
    """read_config, its warnings logged, one line each."""
    config, warnings = read_config(path)
    for warning in warnings:
        log.warning("%s", warning)
    return config


def build(cls: type, table: Any, where: str, warnings: list[str]) -> Any:
    """One table of the file as `cls`; each value must have the type of the field's default."""
    if not isinstance(table, dict):
        raise ConfigError(f"{where} must be a table")
    default, values = cls(), {}
    known = {f.name for f in fields(cls)}
    for key, value in table.items():
        name = f"{where}.{key}" if where else key
        if key not in known:
            warnings.append(f"unknown key {name}")
            continue
        current = getattr(default, key)
        if is_dataclass(current):
            values[key] = build(type(current), value, name, warnings)
        elif isinstance(current, str):
            if not isinstance(value, str):
                raise ConfigError(f"{name} must be a string")
            values[key] = value
        elif isinstance(current, tuple):
            if not isinstance(value, list) or not all(isinstance(v, str) for v in value):
                raise ConfigError(f"{name} must be a list of strings")
            values[key] = tuple(value)
        else:  # a layout side: control -> action name
            if not isinstance(value, dict) or not all(isinstance(v, str) for v in value.values()):
                raise ConfigError(f"{name} must be a table of control = \"action\"")
            values[key] = dict(value)
    return cls(**values)


def validate(config: Config) -> None:
    """What the types do not say: the backends, what each needs, herdr's keys, the layout's names."""
    for name, value, choices in (("talk.backend", config.talk.backend, TALK_BACKENDS),
                                 ("jump.backend", config.jump.backend, JUMP_BACKENDS)):
        if value not in choices:
            raise ConfigError(f"{name}: {value!r} is not one of {', '.join(choices)}")
    needs = {"voice-flow": ["toggle"], "command": ["start"]}.get(config.talk.backend, [])
    needs = [f"talk.{key}" for key in needs if not getattr(config.talk, key)]
    needs += [f"jump.{key}" for key in ("items", "go")
              if config.jump.backend == "command" and not getattr(config.jump, key)]
    if needs:
        raise ConfigError(f"{needs[0]}: its backend needs this command")
    if config.wheel.plugin and not PLUGIN_ID.fullmatch(config.wheel.plugin):
        raise ConfigError(f"wheel.plugin: {config.wheel.plugin!r} is not a plugin id")
    try:
        if config.herdr.prefix:
            herdr_chord(config.herdr.prefix)
    except ValueError as exc:
        raise ConfigError(f"herdr.prefix: {exc}") from None
    for key in fields(HerdrKeys):
        try:
            herdr_chords(getattr(config.herdr.keys, key.name), config.herdr.prefix)
        except ValueError as exc:
            raise ConfigError(f"herdr.keys.{key.name}: {exc}") from None
    for layer in ("base", "world"):
        named: dict[str, str] = {}  # control -> the name the file gave it
        for control, action in getattr(config.layout, layer).items():
            name = f"layout.{layer}.{control}"
            place = CONTROL_ALIASES.get(control, control)
            if place not in bindable(layer):
                raise ConfigError(f"{name}: no such control here (`hypr-gamepad map --json` names them)")
            if place in named:
                raise ConfigError(f"layout.{layer}: {named[place]} and {control} are the same control")
            named[place] = control
            if action and action not in ACTIONS:
                raise ConfigError(f"{name}: {action!r} is not an action")


def bindable(layer: str) -> set[str]:
    """The controls a layout side can bind: L2 is the layer itself, the right stick scrolls inside the
    window (it flicks only on the desktop side), and the chord belongs to game mode."""
    controls = set(CONTROL_NAMES) - {LAYER_KEY, "rstick", "chord"}
    return controls if layer == "world" else controls - {"rs_up", "rs_down"}


# --- Hyprland ------------------------------------------------------------------------------------

class Hypr:
    """Hyprland's request socket, one connection per request as hyprctl does.

    The signature is found again when Hyprland restarts (a new instance, a new directory)."""

    def __init__(self, runtime: str | None = None, signature: str | None = None, timeout: float = 1.0):
        self.runtime = runtime or os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
        self.signature = signature if signature is not None else os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
        self.timeout = timeout
        self.down = False  # logged once per outage

    def socket_path(self) -> str | None:
        if self.signature:
            path = os.path.join(self.runtime, "hypr", self.signature, ".socket.sock")
            if os.path.exists(path):
                return path
        found = sorted(glob.glob(os.path.join(self.runtime, "hypr", "*", ".socket.sock")), key=os.path.getmtime)
        if not found:
            return None
        self.signature = Path(found[-1]).parent.name
        return found[-1]

    def request(self, message: str) -> str | None:
        path = self.socket_path()
        try:
            if path is None:
                raise FileNotFoundError("no Hyprland socket")
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
                sock.settimeout(self.timeout)
                sock.connect(path)
                sock.sendall(message.encode())
                chunks = []
                while chunk := sock.recv(65536):
                    chunks.append(chunk)
        except OSError as exc:
            if not self.down:
                log.info("Hyprland does not answer: %s", exc)
            self.down = True
            self.signature = ""  # look again next time: Hyprland may have restarted
            return None
        if self.down:
            log.info("Hyprland answers again")
        self.down = False
        return b"".join(chunks).decode("utf-8", "replace")

    def _ok(self, verb: str, text: str) -> bool:
        answer = self.request(f"{verb} {text}")
        if answer is not None and answer.strip() == "ok":
            return True
        if answer is not None:
            log.info("%s %s: %s", verb, text, answer.strip())
        return False

    def dispatch(self, expr: str) -> bool:
        """Run one Lua dispatcher expression, e.g. hl.dsp.focus({ direction = "l" })."""
        return self._ok("dispatch", expr)

    def eval(self, lua: str) -> bool:
        """Run a Lua chunk in Hyprland's config state (where omaspaces.split lives)."""
        return self._ok("eval", lua)

    def json(self, what: str) -> Any:
        answer = self.request(f"j/{what}")
        try:
            return json.loads(answer) if answer else None
        except json.JSONDecodeError:
            return None


class DryHypr(Hypr):
    """Looks at Hyprland but changes nothing: every dispatch and eval is printed."""

    def dispatch(self, expr: str) -> bool:
        print(f"dry: dispatch {expr}", flush=True)
        return True

    def eval(self, lua: str) -> bool:
        print(f"dry: eval {lua}", flush=True)
        return True


# --- The focused window ---------------------------------------------------------------------------

TERMINALS = {"foot", "kitty", "Alacritty", "com.mitchellh.ghostty", "org.wezfurlong.wezterm", "org.omarchy.terminal"}
BROWSERS = {"chromium", "google-chrome", "zen", "firefox", "brave-browser", "microsoft-edge"}
HERDR_CLASSES = {"org.omarchy.herdr"}
HERDR_PROGRAMS = {"herdr"}
# [windows] adds to each of these sets, and names the class prefixes and board titles.
# herdr titles its window "{hostname}: {workspace}" (ui.window_title): "desktop: MAIN",
# "server: BACKEND". The title is all that tells a terminal running herdr on another machine
# over a plain `ssh`; a shell's own title carries "user@host".
HERDR_TITLE = re.compile(r"^[A-Za-z0-9][\w.-]*: \S")


@dataclass(frozen=True)
class Window:
    address: str
    cls: str
    title: str
    kind: str      # herdr | board | browser | terminal | other
    grouped: int   # windows in its Hyprland group; 0 when it is in none


def is_terminal(cls: str) -> bool:
    return cls in TERMINALS or cls in CONFIG.windows.terminals


def classify(cls: str, title: str, herdr_runs: bool) -> str:
    windows = CONFIG.windows
    if cls in HERDR_CLASSES or cls in windows.herdr_classes or cls.startswith(windows.herdr_class_prefixes):
        return "herdr"
    if title in windows.board_titles:
        return "board"
    if cls in BROWSERS or cls in windows.browsers:
        return "browser"
    if is_terminal(cls):
        return "herdr" if herdr_runs or HERDR_TITLE.match(title) else "terminal"
    return "other"


def runs_herdr(pid: int, proc: str = "/proc", depth: int = 4) -> bool:
    """Whether a herdr client runs under this process: a local one (foot > bash > herdr) or one on
    another machine (foot > bash > ssh server ... herdr attach), by the program names in
    HERDR_PROGRAMS and [windows].herdr_programs."""
    programs = HERDR_PROGRAMS | set(CONFIG.windows.herdr_programs)
    frontier = [pid]
    for _ in range(depth):
        found: list[int] = []
        for parent in frontier:
            try:
                kids = Path(proc, str(parent), "task", str(parent), "children").read_text().split()
            except OSError:
                continue
            for kid in kids:
                try:
                    argv = Path(proc, kid, "cmdline").read_bytes().split(b"\0")
                except OSError:
                    continue
                if any(Path(arg.decode(errors="replace")).name in programs for arg in argv if arg):
                    return True
                found.append(int(kid))
        frontier = found[:64]
    return False


class Windows:
    """The focused window, read from Hyprland at the moment of a press."""

    def __init__(self, hypr: Hypr, proc: str = "/proc"):
        self.hypr, self.proc = hypr, proc

    def active(self) -> Window | None:
        data = self.hypr.json("activewindow")
        if not isinstance(data, dict) or not data.get("address"):
            return None
        cls, title = str(data.get("class") or ""), str(data.get("title") or "")
        pid = int(data.get("pid") or 0)
        herdr = is_terminal(cls) and pid > 0 and runs_herdr(pid, self.proc)
        grouped = data.get("grouped")
        return Window(str(data["address"]), cls, title, classify(cls, title, herdr),
                      len(grouped) if isinstance(grouped, list) else 0)


