        return f"hl.dsp.exec_cmd({lua_long(shell_line(argv))})" if argv else None

    def __call__(self, pad: "Pad", press: Press) -> None:
        expr = self.expr()
        if expr:
            pad.hypr.dispatch(expr)

    @property
    def probes(self) -> list[str]:
        expr = self.expr()
        return [f"local _ = {expr}"] if expr else []


