def screen_toward(monitors: Any, direction: str) -> str | None:
    """The screen to focus from the focused one: the nearest whose middle lies that way (its offset
    that way at least as large as its offset across), else, for left and right, the one before or
    after in reading order (top to bottom, then left to right), round. Up past the top, down past the
    bottom, or no focused screen: None."""
    if not isinstance(monitors, list):
        return None
    screens = []
    for m in monitors:
        try:
            w, h = m["width"] / m["scale"], m["height"] / m["scale"]
            if int(m.get("transform", 0)) % 2:   # turned a quarter: the sides swap
                w, h = h, w
            screens.append((m["y"] + h / 2, m["x"] + w / 2, str(m["name"]), bool(m.get("focused"))))
        except (KeyError, TypeError, ValueError, ZeroDivisionError):
            continue
    here = next((sc for sc in screens if sc[3]), None)
    if here is None:
        return None
    wx, wy = {"left": (-1, 0), "right": (1, 0), "up": (0, -1), "down": (0, 1)}[direction]
    best: tuple[float, str] | None = None
    for cy, cx, name, _ in screens:
        dx, dy = cx - here[1], cy - here[0]
        along, across = dx * wx + dy * wy, abs(dx * wy) + abs(dy * wx)
        if along > 0 and along >= across and (best is None or dx * dx + dy * dy < best[0]):
            best = (dx * dx + dy * dy, name)
    if best is not None:
        return best[1]
    if direction in ("left", "right") and len(screens) > 1:
        order = sorted(screens)
        return order[(order.index(here) + (1 if direction == "right" else -1)) % len(order)][2]
    return None


@dataclass(frozen=True)
class screen:
    """Focus the screen that way, by name, from where the screens stand (screen_toward). Hyprland's
    own direction ("l", "u") finds only a screen whose edge touches that side
    (MonitorQueryCore::directionLookup, v0.56.2): with three screens stacked in a column, left and
    right never moved (a user's first run, 2026-10-29). A monitor is found only when a dispatcher runs,
    so the probe builds one for "current", and a direction with no screen is a tick in the hand."""

    direction: str

    def __call__(self, pad: "Pad", press: Press) -> None:
        name = screen_toward(pad.hypr.json("monitors"), self.direction)
        if name is None:
            pad.fx.rumble("tick")
            return
        pad.hypr.dispatch(f'hl.dsp.focus({{ monitor = "{name}" }})')

    @property
    def probes(self) -> list[str]:
        return ['local _ = hl.dsp.focus({ monitor = "current" })']


@dataclass(frozen=True)
class Key:
    """One chord for one window, through Hyprland's send_shortcut: Hyprland gives the window keyboard
    focus, the chord, and focus back, in one call (Actions::pass, ConfigActions.cpp, v0.56.2). No
    uinput, and no modifier is left down. Probe 2026-10-29: Alt+Right sent this way to an unfocused
    herdr window switched its tab, and the focused window stayed focused."""

    mods: str  # "", "ALT", "CTRL SHIFT"
    key: str   # an xkb keysym name: Return, Escape, Up, Tab, bracketleft

    def expr(self, address: str) -> str:
        return f'hl.dsp.send_shortcut({{ mods = "{self.mods}", key = "{self.key}", window = "address:{address}" }})'


def chord(mods: str, key: str) -> tuple[Key, ...]:
    return (Key(mods, key),)


HERDR_MODS = {"ctrl": "CTRL", "alt": "ALT", "shift": "SHIFT", "super": "SUPER"}
# herdr's key names, as xkb names them (send_shortcut takes a keysym); a letter or digit is itself.
HERDR_KEYS = {
    "left": "Left", "right": "Right", "up": "Up", "down": "Down", "enter": "Return", "esc": "Escape",
    "tab": "Tab", "space": "space", "backspace": "BackSpace", "delete": "Delete", "insert": "Insert",
    "home": "Home", "end": "End", "pageup": "Prior", "pagedown": "Next",
    "[": "bracketleft", "]": "bracketright", "-": "minus", "minus": "minus", "=": "equal", ";": "semicolon",
    "'": "apostrophe", ",": "comma", ".": "period", "/": "slash", "\\": "backslash", "`": "grave",
}


def herdr_chord(text: str) -> Key:
    """One chord in herdr's syntax ("ctrl+alt+]") as a Key ("CTRL ALT", "bracketright")."""
    *mods, name = text.lower().split("+")
    sym = HERDR_KEYS.get(name) or (name.upper() if re.fullmatch(r"f\d{1,2}", name) else
                                   name if re.fullmatch(r"[a-z0-9]", name) else None)
    if sym is None or any(mod not in HERDR_MODS for mod in mods):
        raise ValueError(f"{text!r} is not a key")
    return Key(" ".join(HERDR_MODS[mod] for mod in mods), sym)


def herdr_chords(text: str, prefix: str) -> tuple[Key, ...]:
    """A herdr key as the chords that press it: "alt+left" is one, "prefix+n" the prefix's then n's.
    "" is none: the action does nothing in herdr. Raises ValueError."""
    if not text:
        return ()
    if text.lower() == "prefix" or text.lower().startswith("prefix+"):
        if not prefix:
            raise ValueError(f"{text!r} needs [herdr].prefix")
        return (herdr_chord(prefix), herdr_chord(text[len("prefix+"):]))
    return (herdr_chord(text),)


def herdr_step(name: str) -> tuple[Key, ...]:
    """The chords of [herdr.keys].<name>, read when they are sent (load_config checked them)."""
    return herdr_chords(getattr(CONFIG.herdr.keys, name), CONFIG.herdr.prefix)


Step = tuple[Key, ...] | str  # chords in order (herdr's prefix, then its key), or a dispatcher


@dataclass(frozen=True)
class keys:
    """An action whose keys depend on the window it was pressed in: `by_kind` maps a window kind to its
    step; "group" serves a window in a Hyprland group whose kind has no step; "*" serves any window.
    `herdr` names the [herdr.keys] entry that is the herdr window's step; "" there sends nothing."""

    by_kind: dict[str, Step]
    herdr: str = ""

    def steps(self) -> dict[str, Step]:
        return {"herdr": herdr_step(self.herdr), **self.by_kind} if self.herdr else self.by_kind

    def step_for(self, window: Window) -> Step | None:
        steps = self.steps()
        if window.kind in steps:
            return steps[window.kind]
        if window.grouped > 1 and "group" in steps:
            return steps["group"]
        return steps.get("*")

    def __call__(self, pad: "Pad", press: Press) -> None:
        if press.window is None:
            return
        step = self.step_for(press.window)
        if isinstance(step, str):
            pad.hypr.dispatch(step)
            return
        for key in step or ():
            if not pad.hypr.dispatch(key.expr(press.window.address)):
                break

    @property
    def probes(self) -> list[str]:
        # address 0x0 is never a window, and building a dispatcher runs nothing anyway
        return [f"local _ = {k.expr('0x0') if isinstance(k, Key) else k}" for step in self.steps().values()
                for k in ([step] if isinstance(step, str) else step)]

    @property
    def keysyms(self) -> list[str]:
        return [k.key for step in self.steps().values() if not isinstance(step, str) for k in step]

    @property
    def kinds(self) -> list[str]:
        """The window kinds it does something in, for the map."""
        return sorted(kind for kind, step in self.steps().items() if step)

    @property
    def kind_labels(self) -> dict[str, str]:
        """herdr's words from [herdr.labels], when herdr has a key for it."""
        if not self.herdr or not herdr_step(self.herdr):
            return {}
        return {"herdr": getattr(CONFIG.herdr.labels, self.herdr)}


@dataclass(frozen=True)
class jump_to:
    """Triangle, as [jump].backend says: herdr's own jump key to a herdr window (elsewhere a note says
    where it works), the command's list of agents (Jump), or nothing."""

    def chords(self) -> tuple[Key, ...]:
        return herdr_step("jump") if CONFIG.jump.backend == "herdr" else ()

    def __call__(self, pad: "Pad", press: Press) -> None:
        if CONFIG.jump.backend == "command":
            pad.jump.press()
            return
        chords = self.chords()
        if not chords:
            return
        window = pad.windows.active()
        if window is None or window.kind != "herdr":
            pad.fx.notify("Triangle jumps inside herdr")
            return
        for key in chords:
            if not pad.hypr.dispatch(key.expr(window.address)):
                break

    @property
    def probes(self) -> list[str]:
        return [f"local _ = {k.expr('0x0')}" for k in self.chords()]

    @property
    def keysyms(self) -> list[str]:
        return [k.key for k in self.chords()]

    @property
    def kinds(self) -> list[str]:
        return ["herdr"] if CONFIG.jump.backend == "herdr" else ["*"]


