def shell_line(argv: tuple[str, ...]) -> str:
    """argv as one shell line: every argument in single quotes, the program only when it needs them."""
    return " ".join([shlex.quote(argv[0])] + ["'" + arg.replace("'", "'\"'\"'") + "'" for arg in argv[1:]])


def lua_long(text: str) -> str:
    """text as a Lua long string, [[...]] with as many = as it takes that nothing inside closes it."""
    level = 0
    while f"]{'=' * level}]" in text or text.endswith("]" + "=" * level):
        level += 1
    return f"[{'=' * level}[{text}]{'=' * level}]"


@dataclass(frozen=True)
class run_board:
    """PS tap: [board].command, run through Hyprland's exec as a key's exec is (it outlives the
