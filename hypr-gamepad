def repeat_gap(profile: str, held: float) -> float:
    """The wait before the next repeat of a control held for `held` seconds."""
    first, gap, *speedup = REPEAT[profile]
    if not speedup:
        return gap
    fastest, ramp = speedup
    return gap + (fastest - gap) * min(1.0, max(0.0, (held - first) / ramp))


