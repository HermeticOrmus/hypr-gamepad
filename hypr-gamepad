@dataclass(frozen=True)
class dispatch:
    """An action that is one Lua dispatcher. Its probe builds the dispatcher without running it:
    Hyprland checks the arguments when it builds one, so `hypr-gamepad check` finds a renamed dispatcher
    or a bad argument after a Hyprland update without moving anything on the screen."""

    expr: str

    def __call__(self, pad: "Pad", press: Press) -> None:
        pad.hypr.dispatch(self.expr)

    @property
    def probes(self) -> list[str]:
        return [f"local _ = {self.expr}"]


@dataclass(frozen=True)
class evaluate:
    """An action that is a Lua chunk, and a chunk that checks it without running it."""

    lua: str
    probe: str

    def __call__(self, pad: "Pad", press: Press) -> None:
        pad.hypr.eval(self.lua)

    @property
    def probes(self) -> list[str]:
        return [self.probe]


def screen_toward(monitors: Any, direction: str) -> str | None:
    """The screen to focus from the focused one: the nearest whose middle lies that way (its offset
    that way at least as large as its offset across), else, for left and right, the one before or
    after in reading order (top to bottom, then left to right), round. Up past the top, down past the
    bottom, or no focused screen: None."""
    if not isinstance(monitors, list):
        return None
    screens = []
    for m in monitors:
        try:
            w, h = m["width"] / m["scale"], m["height"] / m["scale"]
            if int(m.get("transform", 0)) % 2:   # turned a quarter: the sides swap
                w, h = h, w
            screens.append((m["y"] + h / 2, m["x"] + w / 2, str(m["name"]), bool(m.get("focused"))))
        except (KeyError, TypeError, ValueError, ZeroDivisionError):
            continue
    here = next((sc for sc in screens if sc[3]), None)
    if here is None:
        return None
    wx, wy = {"left": (-1, 0), "right": (1, 0), "up": (0, -1), "down": (0, 1)}[direction]
    best: tuple[float, str] | None = None
    for cy, cx, name, _ in screens:
        dx, dy = cx - here[1], cy - here[0]
        along, across = dx * wx + dy * wy, abs(dx * wy) + abs(dy * wx)
        if along > 0 and along >= across and (best is None or dx * dx + dy * dy < best[0]):
            best = (dx * dx + dy * dy, name)
    if best is not None:
        return best[1]
    if direction in ("left", "right") and len(screens) > 1:
        order = sorted(screens)
        return order[(order.index(here) + (1 if direction == "right" else -1)) % len(order)][2]
    return None


@dataclass(frozen=True)
class screen:
    """Focus the screen that way, by name, from where the screens stand (screen_toward). Hyprland's
    own direction ("l", "u") finds only a screen whose edge touches that side
    (MonitorQueryCore::directionLookup, v0.56.2): with three screens stacked in a column, left and
    right never moved (a user's first run, 2026-10-29). A monitor is found only when a dispatcher runs,
    so the probe builds one for "current", and a direction with no screen is a tick in the hand."""

    direction: str

    def __call__(self, pad: "Pad", press: Press) -> None:
        name = screen_toward(pad.hypr.json("monitors"), self.direction)
        if name is None:
            pad.fx.rumble("tick")
            return
        pad.hypr.dispatch(f'hl.dsp.focus({{ monitor = "{name}" }})')

    @property
    def probes(self) -> list[str]:
        return ['local _ = hl.dsp.focus({ monitor = "current" })']


@dataclass(frozen=True)
class Key:
    """One chord for one window, through Hyprland's send_shortcut: Hyprland gives the window keyboard
    focus, the chord, and focus back, in one call (Actions::pass, ConfigActions.cpp, v0.56.2). No
    uinput, and no modifier is left down. Probe 2026-10-29: Alt+Right sent this way to an unfocused
    herdr window switched its tab, and the focused window stayed focused."""

    mods: str  # "", "ALT", "CTRL SHIFT"
    key: str   # an xkb keysym name: Return, Escape, Up, Tab, bracketleft

    def expr(self, address: str) -> str:
        return f'hl.dsp.send_shortcut({{ mods = "{self.mods}", key = "{self.key}", window = "address:{address}" }})'


def chord(mods: str, key: str) -> tuple[Key, ...]:
    return (Key(mods, key),)


Step = tuple[Key, ...] | str  # chords in order (herdr's prefix, then its key), or a dispatcher


@dataclass(frozen=True)
class keys:
    """An action whose keys depend on the window it was pressed in: `by_kind` maps a window kind to its
    step; "group" serves a window in a Hyprland group whose kind has no step; "*" serves any window."""

    by_kind: dict[str, Step]

    def step_for(self, window: Window) -> Step | None:
        if window.kind in self.by_kind:
            return self.by_kind[window.kind]
        if window.grouped > 1 and "group" in self.by_kind:
            return self.by_kind["group"]
        return self.by_kind.get("*")

    def __call__(self, pad: "Pad", press: Press) -> None:
        if press.window is None:
            return
        step = self.step_for(press.window)
        if isinstance(step, str):
            pad.hypr.dispatch(step)
            return
        for key in step or ():
            if not pad.hypr.dispatch(key.expr(press.window.address)):
                break

    @property
    def probes(self) -> list[str]:
        # address 0x0 is never a window, and building a dispatcher runs nothing anyway
        return [f"local _ = {k.expr('0x0') if isinstance(k, Key) else k}" for step in self.by_kind.values()
                for k in ([step] if isinstance(step, str) else step)]

    @property
    def keysyms(self) -> list[str]:
        return [k.key for step in self.by_kind.values() if not isinstance(step, str) for k in step]


# Workspaces on this screen are omaspaces' when it is loaded (~/.config/hypr/split-workspaces.lua:
# 11-19 on one screen, 21-29 on the next, ...). Its focus_relative steps through the ones in use plus
# one empty, as the keyboard's workspace keys do; without it, Hyprland's own next workspace on this
# monitor.
STEP_WORKSPACE = (
    'local s = package.loaded["omaspaces.split"] '
    'if s then s.focus_relative({delta}) else hl.dispatch(hl.dsp.focus({{ workspace = "m{delta:+d}" }})) end'
)
STEP_PROBE = (
    'local s = package.loaded["omaspaces.split"] '
    'if s and type(s.focus_relative) ~= "function" then error("omaspaces.split has no focus_relative") end '
    'local _ = hl.dsp.focus({ workspace = "m+1" })'
)

