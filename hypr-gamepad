    "rstick": "Right stick", "chord": "PS + Options", "mic": "Mic button",
    "up": "D-pad up", "down": "D-pad down", "left": "D-pad left", "right": "D-pad right",
    "ls_up": "Left stick up", "ls_down": "Left stick down", "ls_left": "Left stick left", "ls_right": "Left stick right",
    "rs_up": "Right stick up", "rs_down": "Right stick down",
    "cross": "Cross", "circle": "Circle", "square": "Square", "triangle": "Triangle",
    "l1": "L1", "r1": "R1", "l2": "L2", "r2": "R2", "l3": "L3", "r3": "R3",
    "ps": "PS", "options": "Options", "create": "Create",
}


# --- The pad, as events in and actions out --------------------------------------------------------

def flick(x: float, y: float, current: str | None) -> str | None:
    """The left stick read as a D-pad: its dominant direction, with hysteresis."""
    if abs(x) >= abs(y):
        direction, tilt = ("right" if x > 0 else "left"), abs(x)
    else:
        direction, tilt = ("down" if y > 0 else "up"), abs(y)
    if current is None:
        return direction if tilt >= FLICK_ON else None
    if tilt < FLICK_OFF:
        return None
    return direction if direction != current and tilt >= FLICK_ON else current


class Pad:
    """Turns the pad's events into actions. Pure apart from what it is handed (Hyprland, Fx, the
    clock), so the tests drive it with recorded events."""

    def __init__(self, hypr: Hypr, fx: Fx, clock: Callable[[], float] = time.monotonic,
                 windows: Windows | None = None, runner: Runner | None = None, voice: Path | None = None,
                 wheel: Wheel | None = None, mode: str = "desk", lights: Lights | None = None):
        self.hypr, self.fx, self.clock = hypr, fx, clock
        self.windows = windows or Windows(hypr)
        self.runner = runner or Runner()
        self.talk = Talk(self.runner, fx, clock, voice or voice_dir())
        self.jump = Jump(self.runner, fx, clock)
        self.scroll = Scroll(hypr, wheel or Wheel(), clock)
        self.sessions = SessionsWheel(hypr, fx, clock)
        self.map = PadMap(hypr, clock)
        self.mode = mode          # desk: the pad drives the desktop (grabbed); game: a game has it
        self.buttons: set[str] = set()
        self.lights = lights or Lights()
        self.lit_color: tuple[int, int, int] | None = None
        self.lit_screen: int | None = None
        self.screen_at = float("-inf")
        self.world = False
        self.held: dict[str, Press] = {}
        self.hat = {ABS_HAT0X: 0, ABS_HAT0Y: 0}
        self.stick = {"left": [0.0, 0.0], "right": [0.0, 0.0]}
        self.flicked: str | None = None
        self.rflicked: str | None = None   # the right stick's flick, in the world layer

    def feed(self, etype: int, code: int, value: int) -> None:
        if etype == EV_KEY:
            name = BUTTONS.get(code)
            if name is None or value == 2:  # 2 is the kernel's autorepeat; repeats are ours
                return
            if value:
                self.buttons.add(name)
            else:
                self.buttons.discard(name)
            if value and name in GAME_CHORD and GAME_CHORD <= self.buttons:
                self.toggle_mode()
                return
            if self.mode == "game":
                return
            if value:
                self.press(name)
            else:
                self.release(name)
        elif etype == EV_ABS:
            if self.mode == "game":
                self.seed(code, value)  # where the sticks are, for the way back; nothing acts
                return
            if code in self.hat:
                self.on_hat(code, value)
            elif code in STICKS:
                side, axis = STICKS[code]
                self.stick[side][axis] = max(-1.0, min(1.0, (value - 128) / 127))
                if side == "left":
                    self.on_flick(flick(*self.stick["left"], self.flicked))
                elif self.sessions.token is not None:
                    self.sessions.aim(*self.stick["right"])  # the wheel is open: the stick aims, never scrolls
                    self.scroll.pause()
                elif self.world:
                    self.on_rflick(flick(*self.stick["right"], self.rflicked))  # L2 held: text size
                else:
                    self.scroll.stick(*self.stick["right"])

    def resync(self, down: set[int], axes: dict[int, int]) -> None:
        """Set the Pad from the pad's real state after the kernel dropped events: a button let go in
        the drop is released, one still down is pressed, the axes take their places."""
        for code, name in BUTTONS.items():
            if (code in down) != (name in self.buttons):
                self.feed(EV_KEY, code, 1 if code in down else 0)
        for code, value in axes.items():
            self.feed(EV_ABS, code, value)

    def button(self, name: str, down: bool) -> None:
        """A button read outside evdev (the mic button, from the raw reports)."""
        if self.mode == "game":
            return
        if down:
            self.press(name)
        else:
            self.release(name)

    def seed(self, code: int, value: int) -> None:
        """Where an axis already is when the pad appears: remembered, never pressed."""
        if code in self.hat:
            self.hat[code] = value
        elif code in STICKS:
            side, axis = STICKS[code]
            self.stick[side][axis] = max(-1.0, min(1.0, (value - 128) / 127))

    def on_hat(self, code: int, value: int) -> None:
        low, high = ("left", "right") if code == ABS_HAT0X else ("up", "down")
        old, self.hat[code] = self.hat[code], value
        if old == value:
            return
        if old:
            self.release(low if old < 0 else high)
        if value:
            self.press(low if value < 0 else high)

    def on_rflick(self, direction: str | None) -> None:
        old, self.rflicked = self.rflicked, direction
        if old == direction:
            return
        if old:
            self.release(f"rs_{old}")
        if direction:
            self.press(f"rs_{direction}")

    def on_flick(self, direction: str | None) -> None:
        old, self.flicked = self.flicked, direction
        if old == direction:
            return
        if old:
            self.release(f"ls_{old}")
        if direction:
            self.press(f"ls_{direction}")

    def press(self, control: str) -> None:
        if control == LAYER_KEY:
            self.world = True
            self.fx.rumble("click")
            self.map.layer("world")
            # The right stick changes text size now, not scroll: a scroll stops, and a tilt already
            # held counts as flicked, so it sizes nothing until the stick has come back.
            self.scroll.pause()
            self.rflicked = flick(*self.stick["right"], None)
            return
        if control == "circle" and (self.talk.drop() or self.sessions.cancel()):
            return  # Circle while talking drops the recording, with the wheel open closes it; not Esc
        layer = "world" if self.world else "base"
        name = LAYOUT[layer].get(control)
        if name is None:
            return
        action = ACTIONS[name]
        press = Press(control, layer, action, self.windows.active() if action.window else None, started=self.clock())
        if action.repeat:
            press.next_at = self.clock() + REPEAT[action.repeat][0]
        self.held[control] = press
        if not action.tap:
            self.run(press)

    def release(self, control: str) -> None:
        if control == LAYER_KEY:
            self.world = False
            self.map.layer("base")
            if self.rflicked:
                self.held.pop(f"rs_{self.rflicked}", None)  # a text size held on the stick stops with L2
            self.rflicked = None
            # The stick scrolls again: at once when it rests, else once it has come back to rest.
            self.scroll.pause()
            self.scroll.stick(*self.stick["right"])
            return
        press = self.held.pop(control, None)
        if press is not None and press.action.tap and not press.hold_fired and self.clock() - press.started < TAP_S:
            self.run(press)
        if press is not None and press.action.release is not None:
            try:
                press.action.release(self, press)
            except Exception:
                log.exception("%s (let go) failed", press.action.label)

    def tick(self) -> None:
        self.talk.tick()
        self.jump.tick()
        self.scroll.tick()
        self.show_lights()
        self.sessions.flush()
        self.runner.reap()
        now = self.clock()
        for press in list(self.held.values()):
            if press.action.hold and not press.hold_fired and now - press.started >= TAP_S:
                press.hold_fired = True
                try:
                    press.action.hold(self, press)
                except Exception:
                    log.exception("%s (held) failed", press.action.label)
            if press.next_at is not None and now >= press.next_at:
                press.next_at = now + repeat_gap(press.action.repeat, now - press.started)
                self.run(press)

    def run(self, press: Press) -> None:
        log.debug("%s %s -> %s", press.layer, press.control, press.action.label)
        try:
            press.action.run(self, press)
        except Exception:  # one bad action must never take the pad away
            log.exception("%s failed", press.action.label)

    def light_state(self) -> str:
        if self.mode == "game":
            return "game"
        if self.talk.active():
            return "talk"
        return "world" if self.world else "desk"

    def show_lights(self) -> None:
        """The lightbar follows the state on every tick; the player lights follow the focused screen,
        read twice a second (any mouse or key can move it). Each is written only when it changes."""
        color = LIGHT[self.light_state()]
        if color != self.lit_color:
            self.lit_color = color
            self.lights.color(color)
        now = self.clock()
        if now - self.screen_at >= SCREEN_EVERY_S:
            self.screen_at = now
            screen = focused_screen(self.hypr)
            if screen is not None and screen != self.lit_screen:
                self.lit_screen = screen
                self.lights.players(PLAYERS.get(screen, ()))

    def toggle_mode(self) -> None:
        """PS + Options: the pad goes to a game, or comes back. Whatever the first of the two buttons
        started (the map, the wheel) closes, and nothing is left held."""
        self.quiet()
        if self.mode == "desk":
            self.mode = "game"
            self.fx.rumble("long")
            self.fx.notify("Game mode", "The pad is the game's. PS + Options brings it back.")
        else:
            self.mode = "desk"
            self.fx.rumble("double")
            self.fx.notify("Desk mode", "The pad drives the desktop again.")
        log.info("%s mode", self.mode)

    def quiet(self) -> None:
        """Let go of everything the pad holds: a talk is dropped, the wheel and the map close."""
        self.talk.drop()  # a talk that nobody let go of is never pasted
        self.sessions.cancel()
        self.map.hide()
        self.scroll.reset()
        self.held.clear()  # no release actions: their buttons are now the chord's or gone
        self.world = False
        self.rflicked = None

    def reset(self) -> None:
        """The pad went away: let go of everything it held. The mode stays for its return."""
        self.talk.reset()
        self.jump.reset()
        self.scroll.reset()
        self.sessions.cancel()
        self.map.hide()
        for control in list(self.held):
            self.held.pop(control)  # no release actions: a lost pad lets go of nothing on purpose
        self.buttons.clear()
        self.world = False
        self.hat = {ABS_HAT0X: 0, ABS_HAT0Y: 0}
        self.stick = {"left": [0.0, 0.0], "right": [0.0, 0.0]}
        self.flicked = None
        self.rflicked = None


# --- The shell: the real pad ----------------------------------------------------------------------

RUMBLE = {  # pattern -> (milliseconds, strong motor, weak motor)
    "click": (25, 0x0000, 0x5000),
    "tick": (60, 0x2000, 0x5000),
    "long": (320, 0x6000, 0x6000),
}


class Motors(Fx):
    """The pad's rumble motors and desktop notifications."""

    def __init__(self, dev: Any, dry: bool = False):
        self.dev, self.dry = dev, dry  # dry: notifications are printed, never shown on the screen
        self.effects: dict[str, int] = {}
        self.later: list[tuple[float, str]] = []
        self.children: list[subprocess.Popen[bytes]] = []

    def rumble(self, pattern: str) -> None:
        if pattern == "double":
            self.play("tick")
            self.later.append((time.monotonic() + 0.13, "tick"))
            return
        self.play(pattern)

    def play(self, pattern: str) -> None:
        from evdev import ecodes, ff

        try:
            if pattern not in self.effects:
                ms, strong, weak = RUMBLE[pattern]
                effect = ff.Effect(ecodes.FF_RUMBLE, -1, 0, ff.Trigger(0, 0), ff.Replay(ms, 0),
                                   ff.EffectType(ff_rumble_effect=ff.Rumble(strong, weak)))
                self.effects[pattern] = self.dev.upload_effect(effect)
            self.dev.write(ecodes.EV_FF, self.effects[pattern], 1)
        except OSError as exc:
            log.info("rumble %s: %s", pattern, exc)

    def notify(self, title: str, body: str = "") -> None:
        if self.dry:
            print(f"dry: notify {title}: {body}", flush=True)
            return
        # Omarchy's action app (omarchy-notification-send's default): the shell shows its notes in Do
        # Not Disturb, as they answer a press (shown, they reach the history like any other).
        argv = ["notify-send", "-a", "omarchy-action", "-t", "2500",
                "-h", "string:x-canonical-private-synchronous:hypr-gamepad", title, body]
        try:
            self.children.append(subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                                  stderr=subprocess.DEVNULL))
        except OSError as exc:
            log.info("notify: %s", exc)

    def pump(self, now: float) -> None:
        due = [p for at, p in self.later if at <= now]
        self.later = [(at, p) for at, p in self.later if at > now]
        for pattern in due:
            self.play(pattern)
        self.children = [c for c in self.children if c.poll() is None]


class UinputWheel(Wheel):
    """A virtual mouse that only scrolls: hi-res wheel events (REL_WHEEL_HI_RES, 120 a notch) for a
    smooth scroll, and the classic notches for programs that read only those. It has the usual mouse
    axes and buttons so libinput takes it as a pointer; it never sends them."""

    NAME = "hypr-gamepad wheel"

    def __init__(self) -> None:
        from evdev import UInput, ecodes

        self.ecodes = ecodes
        caps = {ecodes.EV_REL: [ecodes.REL_X, ecodes.REL_Y, ecodes.REL_WHEEL, ecodes.REL_HWHEEL,
                                ecodes.REL_WHEEL_HI_RES, ecodes.REL_HWHEEL_HI_RES],
                ecodes.EV_KEY: [ecodes.BTN_LEFT, ecodes.BTN_RIGHT, ecodes.BTN_MIDDLE]}
        self.ui = UInput(caps, name=self.NAME)

    def scroll(self, vertical: int, horizontal: int, notches_v: int, notches_h: int) -> None:
        e = self.ecodes
        for code, value in ((e.REL_WHEEL_HI_RES, vertical), (e.REL_HWHEEL_HI_RES, horizontal),
                            (e.REL_WHEEL, notches_v), (e.REL_HWHEEL, notches_h)):
            if value:
                self.ui.write(e.EV_REL, code, value)
        if vertical or horizontal or notches_v or notches_h:
            self.ui.syn()


class DryWheel(Wheel):
    """--dry: one line per scroll gesture, its total."""

    def __init__(self) -> None:
        self.total = [0, 0]

    def scroll(self, vertical: int, horizontal: int, notches_v: int, notches_h: int) -> None:
        if not (vertical or horizontal or notches_v or notches_h):
            if any(self.total):
                print(f"dry: scrolled {self.total[0]} up, {self.total[1]} right (hi-res, 120 a notch)", flush=True)
            self.total = [0, 0]
            return
        self.total[0] += vertical
        self.total[1] += horizontal


def make_wheel(dry: bool) -> Wheel:
    if dry:
        return DryWheel()
    try:
        return UinputWheel()
    except (OSError, ImportError) as exc:
        log.info("no scroll: the virtual wheel could not be made (%s)", exc)
        return Wheel()


class SysfsLights(Lights):
    """The pad's LED class files (hid-playstation): <input>:rgb:indicator and <input>:white:player-N.
    Writable with the udev rule; without it the first write fails, is logged once, and the lights stay
    as the kernel set them."""

    def __init__(self, input_dir: str):
        name = Path(input_dir).name  # inputNNN, the pad's input device
        self.rgb = Path("/sys/class/leds", f"{name}:rgb:indicator")
        self.player = [Path("/sys/class/leds", f"{name}:white:player-{n}") for n in range(1, 6)]
        self.broken = False

    def write(self, path: Path, value: str) -> None:
        if self.broken:
            return
        try:
            path.write_text(value)
        except OSError as exc:
            self.broken = True
            log.info("no lights: %s (the udev rule is not installed?)", exc)

    def color(self, rgb: tuple[int, int, int]) -> None:
        self.write(self.rgb / "multi_intensity", " ".join(map(str, rgb)))
        self.write(self.rgb / "brightness", "255")

    def players(self, lit: tuple[int, ...]) -> None:
        for n, path in enumerate(self.player, start=1):
            self.write(path / "brightness", "1" if n in lit else "0")


class DryLights(Lights):
    def color(self, rgb: tuple[int, int, int]) -> None:
        print(f"dry: lightbar {rgb[0]} {rgb[1]} {rgb[2]}", flush=True)

    def players(self, lit: tuple[int, ...]) -> None:
        print(f"dry: player lights {' '.join(map(str, lit)) or 'off'}", flush=True)


MIC_BIT = 0x04  # buttons[2] bit 2 in the DualSense input report (hid-playstation DS_BUTTONS2_MIC_MUTE)


def mic_down(report: bytes) -> bool | None:
    """Whether the mic button is down in one raw report; None for a report that is not an input one.
    Bluetooth 0x31 carries the input struct from byte 2, USB 0x01 from byte 1; its buttons start at
    the 8th byte of it (x, y, rx, ry, z, rz, seq; read on a test machine: sticks at 2-5 matched evdev's)."""
    if len(report) >= 12 and report[0] == 0x31:
        return bool(report[2 + 9] & MIC_BIT)
    if len(report) >= 11 and report[0] == 0x01:
        return bool(report[1 + 9] & MIC_BIT)
    return None


class MicReader:
    """The pad's hidraw node, read only for the mic button. Absent or unreadable (no udev rule): None."""

    def __init__(self, input_dir: str):
        self.fd: int | None = None
        self.down = False
        hid = Path(input_dir, "device")
        for node in sorted(hid.glob("hidraw/hidraw*")):
            try:
                self.fd = os.open(f"/dev/{node.name}", os.O_RDONLY | os.O_NONBLOCK)
                log.info("mic button from /dev/%s", node.name)
            except OSError as exc:
                log.info("no mic button: /dev/%s: %s (the udev rule is not installed?)", node.name, exc)
            break

    def read(self, pad: Pad) -> None:
        if self.fd is None:
            return
        while True:
            try:
                report = os.read(self.fd, 128)
            except BlockingIOError:
                return
            except OSError:
                self.close()
                return
            down = mic_down(report)
            if down is not None and down != self.down:
                self.down = down
                pad.button("mic", down)

    def close(self) -> None:
        if self.fd is not None:
            try:
                os.close(self.fd)
            except OSError:
                pass
        self.fd = None


def find_pad(path: str | None = None) -> Any:
    import evdev

    for candidate in [path] if path else evdev.list_devices():
        try:
            dev = evdev.InputDevice(candidate)
        except OSError:
            continue
        if dev.name in PAD_NAMES:
            return dev
        dev.close()
    return None


def battery(mac: str) -> str:
    base = BATTERY.format(mac=mac.lower())
    try:
        level = Path(base, "capacity").read_text().strip()
        state = Path(base, "status").read_text().strip()
    except OSError:
        return "unknown"
    return f"{level}% {state.lower()}"


def input_dir(dev: Any) -> str:
    """/sys/class/input/eventN/device: the pad's inputNNN, whose LEDs and hidraw node are siblings."""
    return os.path.realpath(f"/sys/class/input/{os.path.basename(dev.path)}/device")


def serve(dev: Any, pad: Pad, motors: Motors, mic: MicReader | None = None) -> None:
    for code in AXES:
        info = dev.absinfo(code)
        if info is not None:
            pad.seed(code, int(info.value))
    grab = Grabber(dev, motors)
    grab.sync(pad.mode == "desk")
    reader = EventReader(dev, pad)
    os.set_blocking(dev.fd, False)
    while True:
        fds = [dev.fd] + ([mic.fd] if mic is not None and mic.fd is not None else [])
        ready, _, _ = select.select(fds, [], [], TICK_S)
        if mic is not None and mic.fd in ready:
            mic.read(pad)
        if dev.fd in ready:
            reader.read()
        pad.tick()
        motors.pump(time.monotonic())
        grab.sync(pad.mode == "desk")


class EventReader:
    """The pad's events into the Pad. When the kernel drops events (SYN_DROPPED: its buffer filled while
    the loop was busy), everything up to the next report is skipped and the Pad is set from the pad's
    real state instead, so a release lost in the drop still lets go (independent review, 2026-10-29)."""

    def __init__(self, dev: Any, pad: Pad):
        self.dev, self.pad = dev, pad
        self.dropping = False

    def read(self) -> None:
        try:
            events = list(self.dev.read())
        except BlockingIOError:
            return
        for event in events:
            if event.type == EV_SYN:
                if event.code == SYN_DROPPED:
                    self.dropping = True
                elif event.code == SYN_REPORT and self.dropping:
                    self.dropping = False
                    self.resync()
                continue
            if not self.dropping:
                self.pad.feed(event.type, event.code, event.value)

    def resync(self) -> None:
        log.info("events dropped: the pad's state read again")
        axes = {}
        for code in AXES:
            info = self.dev.absinfo(code)
            if info is not None:
                axes[code] = int(info.value)
        self.pad.resync(set(self.dev.active_keys()), axes)


class Grabber:
    """Holds the pad in desk mode, lets go in game mode. A grab another program blocks (it holds the
    pad itself, so hypr-gamepad reads nothing meanwhile) is tried again each second and said once."""

    RETRY_S = 1.0

    def __init__(self, dev: Any, fx: Fx, clock: Callable[[], float] = time.monotonic):
        self.dev, self.fx, self.clock = dev, fx, clock
        self.have = False
        self.blocked = False
        self.next_try = float("-inf")

    def sync(self, want: bool) -> None:
        if want == self.have:
            return
        now = self.clock()
        if now < self.next_try:
            return
        try:
            if want:
                self.dev.grab()
            else:
                self.dev.ungrab()
        except OSError as exc:
            self.next_try = now + self.RETRY_S
            if not self.blocked:
                self.blocked = True
                log.info("cannot %s %s: %s; trying each second", "grab" if want else "let go of", self.dev.path, exc)
                self.fx.notify("Pad", "Another program holds the pad. Close it, and the pad comes back here.")
            return
        self.blocked = False
        self.have = want
        log.info("%s %s at %s", "grabbed" if want else "let go of", self.dev.name, self.dev.path)


def run_daemon(dry: bool, device: str | None) -> None:
    hypr: Hypr = DryHypr() if dry else Hypr()
    wheel = make_wheel(dry)  # one virtual wheel for the daemon's life, across pad reconnects
    mode = "desk"            # and one mode: a pad that sleeps mid-game comes back to the game
    waiting = False
    while True:
        dev = find_pad(device)
        if dev is None:
            if not waiting:
                log.info("waiting for the pad")
            waiting = True
            time.sleep(1.0)
            continue
        waiting = False
        motors = Motors(dev, dry=dry)
        where = input_dir(dev)
        lights: Lights = DryLights() if dry else SysfsLights(where)
        mic = MicReader(where)
        pad = Pad(hypr, motors, runner=DryRunner() if dry else None, wheel=wheel, mode=mode, lights=lights)
        way_in = ("Game mode: the pad is the game's. PS + Options brings it back." if mode == "game"
                  else "Hold L2 for the desktop.")
        motors.notify("DualSense ready", f"Battery {battery(dev.uniq or '')}. {way_in}")
        try:
            serve(dev, pad, motors, mic)
        except OSError as exc:
            log.info("pad gone: %s", exc)
        finally:
            pad.reset()
            mic.close()
            mode = pad.mode
            try:
                dev.close()
            except OSError:
                pass
        time.sleep(0.5)


# The map's order, by where a control sits on the pad.
MAP_GROUPS = [
    ("Buttons", ["cross", "circle", "square", "triangle"]),
    ("D-pad", ["up", "down", "left", "right"]),
    ("Shoulders", ["l1", "r1", "l2", "r2"]),
    ("Sticks", ["ls_up", "ls_down", "ls_left", "ls_right", "l3", "rstick", "rs_up", "rs_down", "r3"]),
    ("Middle", ["ps", "options", "create", "mic", "chord"]),
]
# The pad's own marks for the face buttons and the D-pad (escapes keep this file ASCII).
GLYPHS = {"cross": "\u2715", "circle": "\u25cb", "square": "\u25a1", "triangle": "\u25b3",
          "up": "\u2191", "down": "\u2193", "left": "\u2190", "right": "\u2192",
          "ls_up": "\u2191", "ls_down": "\u2193", "ls_left": "\u2190", "ls_right": "\u2192",
          "rs_up": "\u2191", "rs_down": "\u2193"}
# On the map the arrow says which way, so the name is the control alone.
MAP_NAMES = {"up": "D-pad", "down": "D-pad", "left": "D-pad", "right": "D-pad",
             "ls_up": "Left stick", "ls_down": "Left stick", "ls_left": "Left stick", "ls_right": "Left stick",
             "rs_up": "Right stick", "rs_down": "Right stick"}
# What the map says for controls that are not a LAYOUT action (handled by the Pad itself).
MAP_EXTRA = {
    "base": {"l2": "Hold: the desktop side", "rstick": "Scroll; the further, the faster",
             "chord": "Game mode on / off: the pad goes to the game"},
    "world": {"l2": "Held: the desktop side", "chord": "Game mode on / off: the pad goes to the game"},
}


def map_rows(layer: str) -> list[dict[str, Any]]:
    rows = []
    for group, controls in MAP_GROUPS:
        for control in controls:
            if control in LAYOUT[layer]:
                action = ACTIONS[LAYOUT[layer][control]]
                label, labels = action.label, dict(action.labels or {})
                kinds = sorted(action.run.by_kind) if isinstance(action.run, keys) else ["*"]
            elif control in MAP_EXTRA[layer]:
                label, labels, kinds = MAP_EXTRA[layer][control], {}, ["*"]
            else:
                continue
            name = MAP_NAMES.get(control) or CONTROL_NAMES[control]
            rows.append({"control": control, "group": group, "glyph": GLYPHS.get(control, ""), "name": name,
                         "label": label, "labels": labels, "kinds": kinds})
    return rows


def pad_battery() -> str:
    """The pad's charge for the map, "" when no DualSense is there."""
    found = sorted(glob.glob(BATTERY.format(mac="*")))
    for base in found:
        try:
            return Path(base, "capacity").read_text().strip() + "%"
        except OSError:
            continue
    return ""


def print_map(as_json: bool) -> None:
    layers = {layer: map_rows(layer) for layer in LAYOUT}
    if as_json:
        print(json.dumps({"layers": layers, "layer_names": LAYER_NAMES, "battery": pad_battery()}, indent=1))
        return
    for layer, rows in layers.items():
        if not rows:
            continue
        print(LAYER_NAMES[layer])
        for row in rows:
            print(f"  {row['glyph'] or ' '} {row['name']:<12} {row['label']}")


def check(hypr: Hypr) -> int:
    """Builds every action's dispatcher in the running Hyprland without running one. 0 = all build."""
    failed = 0
    extra = {"scroll_pointer": POINTER_TO.format(x=0, y=0),  # dispatchers that are not a control's
             "sessions_wheel": f'hl.dsp.event("{WHEEL_ID} cancel")',
             "map": f'hl.dsp.event("{MAP_ID} hide")'}
    for name, expr in extra.items():
        answer = hypr.request(f"eval local _ = {expr}")
        ok = answer is not None and answer.strip() == "ok"
        failed += not ok
        print(f"{'ok  ' if ok else 'FAIL'} {name}{'' if ok else ': ' + (answer or 'Hyprland does not answer').strip()}")
    for name, action in ACTIONS.items():
        problems = []
        for probe in getattr(action.run, "probes", []):
            answer = hypr.request(f"eval {probe}")
            if answer is None or answer.strip() != "ok":
                problems.append((answer or "Hyprland does not answer").strip())
        # A key name is resolved only when a chord is sent, and a bad one then raises Hyprland's
        # red error bar on the screen; so the names are checked here, in libxkbcommon itself.
        problems += [f"{sym} is not a key name" for sym in getattr(action.run, "keysyms", []) if not keysym_known(sym)]
        if not hasattr(action.run, "probes"):
            continue  # not Hyprland's (talk, ideas, jump, map)
        failed += bool(problems)
        print(f"{'FAIL' if problems else 'ok  '} {name}{': ' + '; '.join(problems) if problems else ''}")
    return 1 if failed else 0


def keysym_known(name: str) -> bool:
    """xkb_keysym_from_name, as Hyprland's resolveKeycode calls it (case-insensitive)."""
    import ctypes
    import ctypes.util

    lib = ctypes.CDLL(ctypes.util.find_library("xkbcommon") or "libxkbcommon.so.0")
    lib.xkb_keysym_from_name.argtypes = [ctypes.c_char_p, ctypes.c_int]
    lib.xkb_keysym_from_name.restype = ctypes.c_uint32
    return lib.xkb_keysym_from_name(name.encode(), 1) != 0


def print_status() -> None:
    try:
        dev = find_pad()
    except ImportError:
        print("pad: python-evdev is not installed")
        dev = None
    else:
        if dev is None:
            print("pad: not connected")
        else:
            print(f"pad: {dev.name} at {dev.path}, battery {battery(dev.uniq or '')}")
            where = input_dir(dev)
            rgb = SysfsLights(where).rgb / "multi_intensity"
            print(f"lights: {'writable' if os.access(rgb, os.W_OK) else 'not writable (install the udev rule)'}")
            nodes = sorted(Path(where, "device").glob("hidraw/hidraw*"))
            node = f"/dev/{nodes[0].name}" if nodes else "none"
            readable = bool(nodes) and os.access(node, os.R_OK)
            print(f"mic button: {node} {'readable' if readable else 'not readable (install the udev rule)'}")
            dev.close()
    hypr = Hypr()
    active = hypr.json("activewindow")
    if active is None:
        print("hyprland: not answering")
    else:
        print(f"hyprland: {hypr.signature[:24]}..., focused: {active.get('class') or '-'}")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="hypr-gamepad", description="The DualSense drives Hyprland.")
    sub = parser.add_subparsers(dest="cmd", required=True)
    run = sub.add_parser("run", help="the daemon")
    run.add_argument("--dry", action="store_true", help="print actions instead of sending them")
    run.add_argument("--device", help="this event node instead of the first DualSense found")
    sub.add_parser("status", help="the pad, its battery, Hyprland")
    sub.add_parser("check", help="build every action in the running Hyprland without running it")
    show = sub.add_parser("map", help="what each control does")
    show.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)

    if args.cmd == "map":
        print_map(args.json)
    elif args.cmd == "status":
        print_status()
    elif args.cmd == "check":
        return check(Hypr())
    else:
        logging.basicConfig(level=logging.INFO, format="hypr-gamepad: %(message)s")
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
        run_daemon(args.dry, args.device)
    return 0


if __name__ == "__main__":
    sys.exit(main())
