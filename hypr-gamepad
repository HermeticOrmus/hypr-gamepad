def focused_screen(hypr: Hypr) -> int | None:
    """1 for the first screen Hyprland lists, 2 for the next, ...: the focused one's place."""
    mons = hypr.json("monitors")
    if not isinstance(mons, list):
        return None
    ordered = sorted((m for m in mons if isinstance(m, dict)), key=lambda m: m.get("id", 0))
    for place, mon in enumerate(ordered, start=1):
        if mon.get("focused"):
            return place
    return None


