# hypr-gamepad: the DualSense's lights, its raw reports to read, and the scroll wheel, for group input.
#
# Installed by hand, as root (it lives under /etc, where the user service never writes):
#   sudo install -m 0644 udev/60-hypr-gamepad.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   then reconnect the pad, or: sudo udevadm trigger --action=add <its leds and hidraw paths>
#
# Lightbar and player lights (hid-playstation LED class files): group input may write them, so
# hypr-gamepad shows the mode (gold desk, red talking, blue game) and the focused screen.
# Sony 054C: 0CE6 DualSense, 0DF2 DualSense Edge; Bluetooth and USB both carry the HID id.
ACTION=="add", SUBSYSTEM=="leds", KERNEL=="input*:rgb:indicator", SUBSYSTEMS=="hid", KERNELS=="*:054C:0CE6.*|*:054C:0DF2.*", RUN+="/bin/sh -c 'chgrp input /sys%p/brightness /sys%p/multi_intensity && chmod g+w /sys%p/brightness /sys%p/multi_intensity'"
ACTION=="add", SUBSYSTEM=="leds", KERNEL=="input*:white:player-*", SUBSYSTEMS=="hid", KERNELS=="*:054C:0CE6.*|*:054C:0DF2.*", RUN+="/bin/sh -c 'chgrp input /sys%p/brightness && chmod g+w /sys%p/brightness'"
# The raw reports: the mic button is in them and nowhere else (hid-playstation sends no event for
# it). Read only, for group input (the desktop user's group, as other gamepad hidraw rules do):
# hypr-gamepad never writes to the pad's raw node, so nothing may.
SUBSYSTEM=="hidraw", KERNELS=="*:054C:0CE6.*|*:054C:0DF2.*", GROUP="input", MODE="0640"
# Smooth scrolling: hypr-gamepad makes a virtual mouse wheel through /dev/uinput, for any pad. Some
# packages open it to group input already (ydotool's 80-uinput.rules does); this says it for everyone.
# Group input can read every keyboard and, with this, make virtual devices: give it only to people you
# trust at this desk.
KERNEL=="uinput", SUBSYSTEM=="misc", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"
